<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- ATAS 8.0.14 is hosted on .NET 10. Targeting its runtime prevents
         System.Runtime version conflicts when using its trading APIs. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <!-- ATAS keeps a loaded strategy assembly resident even after its DLL is
         replaced. A new assembly identity makes a hot-deployed bridge build
         deterministic instead of silently running the previous code. -->
    <AssemblyName>AtasMt5ProbeStrategyV5</AssemblyName>
    <AssemblyVersion>5.0.0.0</AssemblyVersion>
    <FileVersion>5.0.0.0</FileVersion>
    <RootNamespace>AtasMt5ProbeStrategy</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Basis history is embedded in AtasBridgeProbeStrategy. Keep the old
         standalone implementation only as a source reference; the small
         compatibility type keeps previously saved ATAS workspaces loadable. -->
    <Compile Remove="AtasMt5BasisCollectorStrategy.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ATAS.DataFeedsCore">
      <HintPath>$(ATAS_HOME)\ATAS.DataFeedsCore.dll</HintPath>
    </Reference>
    <Reference Include="ATAS.Indicators">
      <HintPath>$(ATAS_HOME)\ATAS.Indicators.dll</HintPath>
    </Reference>
    <Reference Include="ATAS.Strategies">
      <HintPath>$(ATAS_HOME)\ATAS.Strategies.dll</HintPath>
    </Reference>
    <Reference Include="OFT.Attributes">
      <HintPath>$(ATAS_HOME)\OFT.Attributes.dll</HintPath>
    </Reference>
    <Reference Include="Utils.Common">
      <HintPath>$(ATAS_HOME)\Utils.Common.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
